          "chat"
        ],
        "type": "object"
      },
      "output": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "allOf": [
              {
                "properties": {
                  "assistant": {
                    "type": "string"
                  },
                  "created": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "entry": {
                    "description": "The message of the parent it was forked at.",
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "member": {
                    "description": "Whose chat it is.",
                    "type": "string"
                  },
                  "parent": {
                    "description": "The chat it was forked from.",
                    "type": "string"
                  },
                  "title": {
                    "description": "Its title, else its first message's first line.",
                    "type": "string"
                  },
                  "updated": {

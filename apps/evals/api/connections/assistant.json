                      "type": "object"
                    },
                    "type": "array"
                  },
                  "forks": {
                    "description": "Its versions: the chats of its tree of forks, its root and each forked from one of them, each with its parent and entry, the oldest first.",
                    "items": {
                      "properties": {
                        "assistant": {
                          "type": "string"
                        },
                        "created": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "entry": {
                          "description": "The message of the parent it was forked at.",
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "member": {
                          "description": "Whose chat it is.",
                          "type": "string"
                        },
                        "parent": {
                          "description": "The chat it was forked from.",
                          "type": "string"
                        },
                        "title": {
                          "description": "Its title, else its first message's first line.",
                          "type": "string"
                        },
                        "updated": {
                          "format": "date-time",
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "assistant",
                        "member",
                        "title",
                        "created",
                        "updated"
                      ],
                      "type": "object"
                    },
                    "type": "array"

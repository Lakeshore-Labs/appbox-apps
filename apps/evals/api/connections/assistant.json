    {
      "name": "openChat",
      "description": "Opens your chat with an assistant, the chat named if you name one, made the first time; a new chat when you name none. The app named is the chat's, the one it is opened in; none, the organization's. With from and entry, a new chat forked from your chat from at its message entry, holding what came before it, its app from's. A chat that is another member's, another assistant's, or another app's when you name one, is no such chat; an app you cannot open is no such app; an entry not in from is no such message.",
      "input": {
        "additionalProperties": false,
        "properties": {
          "app": {
            "description": "The name of the app the chat is opened in.",
            "type": "string"
          },
          "assistant": {
            "type": "string"
          },
          "chat": {
            "description": "The chat's id: 1 to 128 letters, digits, - and _.",
            "type": "string"
          },
          "entry": {
            "description": "The message of from the fork is made at, your message's id.",
            "type": "string"
          },
          "from": {
            "description": "Your chat the new one is forked from.",
            "type": "string"
          }
        },
        "required": [
          "assistant"
        ],
        "type": "object"
      },
      "output": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "properties": {
              "assistant": {
                "type": "string"
              },
              "created": {
                "format": "date-time",
                "type": "string"
              },
              "entry": {
                "description": "The message of the parent it was forked at.",
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "member": {
                "description": "Whose chat it is.",
                "type": "string"
              },
              "parent": {
                "description": "The chat it was forked from.",
                "type": "string"

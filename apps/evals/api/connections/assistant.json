{
  "url": "/app/assistant/mcp",
  "operations": [
    {
      "name": "ask",
      "description": "Asks the assistant in your chat with it and answers once its run ends, with what it said last, the images its calls showed and how the run ended; a run of the chat busy is superseded. A caller who leaves does not stop the run. An assistant hands part of your request to another you view this way, which runs as you with its own instructions, model and operations: its run is one deeper than the one asking, at most four below yours, and an ask of a chat busy with a run, its own among them, is refused.",
      "input": {
        "additionalProperties": false,
        "properties": {
          "assistant": {
            "type": "string"
          },
          "chat": {
            "type": "string"
          },
          "message": {
            "description": "What you say.",
            "minLength": 1,
            "type": "string"
          },
          "runId": {
            "description": "This ask's id, yours; one is made when absent.",
            "type": "string"
          }
        },
        "required": [
          "assistant",
          "chat",
          "message"
        ],
        "type": "object"
      },
      "output": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "properties": {
              "calls": {
                "description": "The calls the run ended waiting on, when its outcome is waiting; else none.",
                "items": {
                  "properties": {
                    "arguments": {
                      "additionalProperties": true,
                      "description": "What the model called it with.",
                      "type": "object"
                    },
                    "id": {
                      "description": "The call's id, which answer names.",
                      "type": "string"
                    },
                    "name": {
                      "description": "The tool called.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "arguments"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "chat": {
                "type": "string"
              },
              "images": {
                "description": "The images the run's calls made or showed, each at its file's content URL.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "outcome": {
                "description": "How a run ended: waiting when it ended on calls of your browser's waiting on you, such as askUser, which answer answers.",
                "enum": [
                  "answered",
                  "failed",
                  "stopped",
                  "waiting"
                ],
                "type": "string"
              },
              "text": {
                "description": "What the assistant said last in the run, or the result of a call after it.",
                "type": "string"
              }
            },
            "required": [
              "chat",
              "outcome",
              "text",
              "images",
              "calls"
            ],
            "type": "object"
          }
        },
        "required": [
          "result"
        ],
        "type": "object"
      },
      "hints": {
        "readOnly": false,
        "destructive": true,
        "idempotent": false,
        "openWorld": true
      }
    },

{
  "url": "/app/file/mcp",
  "operations": [
    {
      "name": "createFile",
      "description": "Creates a file from the bytes the PUT of them carries, or from content, base64, when called without them, as a tool or by name; one of the two, never both. Content over the cap, 25 MB decoded, is refused.",
      "input": {
        "additionalProperties": false,
        "properties": {
          "app": {
            "description": "An app's name.",
            "type": "string"
          },
          "content": {
            "contentEncoding": "base64",
            "description": "The bytes, base64, when the call carries no stream; at most 34952536 characters, the base64 of 25 MB.",
            "maxLength": 34952536,
            "type": "string"
          },
          "contentType": {
            "description": "The file's media type, the upload's Content-Type.",
            "type": "string"
          },
          "name": {
            "description": "The file's name, as shown and as a download is named.",
            "type": "string"
          }
        },
        "required": [
          "app",
          "contentType",
          "name"
        ],
        "type": "object"
      },
      "output": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "description": "A member's upload: its name, content type, size, who created it and when.",
            "properties": {
              "app": {
                "type": "string"
              },
              "contentType": {
                "type": "string"
              },
              "createdAt": {
                "format": "date-time",
                "type": "string"
              },
              "createdBy": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "parent": {
                "type": "string"
              },
              "role": {
                "description": "The actor's role on the instance, written by the gate on a list and a get.",
                "enum": [
                  "viewer",
                  "editor"
                ],
                "readOnly": true,
                "type": "string"
              },
              "size": {
                "format": "int64",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "contentType",
              "size",
              "createdBy",
              "createdAt",
              "app",
              "parent"
            ],
            "title": "files",
